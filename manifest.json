{
    "manifest_version": 3,
    "version": "1.0",
    "name": "Content Tracker",
    "action": {
        "default_icon": "icon.png"
    },
    "description": "Tracks the number of posts you consume.",
    "permissions": ["windows", "storage", "activeTab", "scripting", "tabs"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["panel.html", "panel.js", "index.css"],
            "matches": ["<all_urls>"]
        }
    ]
}

